events { worker_connections 1024; }
http {
    server {
        listen 80;
        server_tokens off;
        client_max_body_size 16k;
        location / {
            proxy_pass http://10.20.10.10:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_connect_timeout 3s;
        }
    }
}
