PostUp = iptables -A FORWARD -i %i -d 10.10.0.0/16 -j ACCEPT; iptables -A FORWARD -i %i -d 10.20.0.0/16 -j ACCEPT; iptables -A FORWARD -i %i -d 10.30.0.0/16 -j ACCEPT; iptables -A FORWARD -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -A POSTROUTING -s 10.99.0.0/24 -d 10.0.0.0/8 -j MASQUERADE
